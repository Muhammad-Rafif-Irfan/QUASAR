# Copy to .env and set values locally. Never commit .env or a real token.
# Docker Compose loads .env automatically. For scripts/dev.*, export the same
# variables in your shell before starting the API.

# --- Runtime ---
QUASAR_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/quasar.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- IBM Quantum hardware (set exactly one token variable) ---
# Leave both empty to use the local Statevector simulator.
IBM_QUANTUM_TOKEN=
# QISKIT_IBM_TOKEN=

# Hardware runs submit one job per optimizer iteration plus a final sample.
# Keep the bounds small for the hackathon demo and QPU queue safety.
MAX_QAOA_STOPS=3
QAOA_SIMULATOR_MAXITER=8
QAOA_HARDWARE_MAXITER=4

# --- Routing and API guardrails ---
MAX_OPTIMIZATION_STOPS=15
OSMNX_DEADLINE_SECONDS=8
MAX_REQUEST_BODY_KB=512
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
OPTIMIZE_BURST_LIMIT=5
OPTIMIZE_BURST_WINDOW=60
TRUST_PROXY_HEADERS=false
